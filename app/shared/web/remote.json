{
  "_": "THE keys and menu entries of the remote screen, for both remotes: the Phone app's native one (RemoteScreen.kt, PhoneRemote.kt) and the web one (js/remote.js; the Computer app, the TV web page). Add, reorder or rename here and both change. Words: 't' is an id in i18n/<lang>.json (rkey.*), 'sub' the id of the small line under a menu entry. 'phone' / 'web' override fields for that side only, with the reason in 'why'. 'cores': [\"phone\"] or [\"web\"], only that side shows the entry. An entry is either a key ('key': a name from Scenes.KEYS / the /api/key names) or an action ('do': a handler name, 'arg' passed to it); every 'do' needs a handler on both sides (app/shared/tests/remote.test.js and RemoteSpecTest.kt check it). A menu entry may carry 'when' (a condition the handler supplies) or be 'expand' (the handler supplies several entries there). 'needs': what the TV must be able to do (Remote.Kind.caps: adb, store, link, app_list...); on an LG or Samsung TV that lacks one a row key is greyed and a menu entry left out. 'kinds': {kind: {t, icon, why}}, an override of t and icon only for one kind of TV (Remote.Kind: lg, samsung, roku, vidaa; android has none), read by both sides from this file (web: remoteEntry, Phone app: RemoteSpec.Entry.forKind); the 'why' is required, it says why that TV names the key differently; the key itself stays the same. Icons: dev/gen/gen_icons.py. The top row (power, speak, keyboard, more), the arrows, the number keys and the volume / channel bars are laid out by hand on each side.",
  "rows": {
    "more": [
      [
        { "id": "open", "icon": "send", "t": "rkey.open", "do": "open" },
        { "id": "input", "icon": "input", "t": "rkey.input", "do": "inputs" },
        { "id": "air", "icon": "mouse", "t": "rkey.air", "do": "air", "cores": ["phone"], "needs": ["mouse"],
          "why": "the phone's gyroscope (AirMouse.kt): a browser's page has no such sensor on every phone, and the TV web page has no ADB" },
        { "id": "home-web", "icon": "sliders", "t": "rkey.home_custom", "do": "homeCustom", "needs": ["adb"], "cores": ["web"],
          "why": "fills the slot Air mouse has on the phone so the web rows stay four wide; on the phone TV Home is under Tools" },
        { "id": "timer", "icon": "timer", "t": "rkey.timer", "do": "timer", "needs": ["screen_off"] }
      ],
      [
        { "id": "screenshot", "icon": "camera", "t": "rkey.screenshot", "do": "shot", "needs": ["adb"] },
        { "id": "draw", "icon": "pen", "t": "rkey.draw", "do": "draw", "needs": ["adb"] },
        { "id": "scenes", "icon": "scene", "t": "rkey.scenes", "do": "scenes" },
        { "id": "tools", "icon": "wrench", "t": "rkey.tools", "do": "menu", "arg": "tools" }
      ]
    ],
    "nav": [
      [
        { "id": "apps", "icon": "apps", "t": "rkey.apps", "do": "apps" },
        { "id": "back", "icon": "back", "t": "rkey.back", "key": "BACK" },
        { "id": "home", "icon": "home", "t": "rkey.home", "key": "HOME" },
        { "id": "settings", "icon": "settings", "t": "rkey.settings", "key": "SETTINGS",
          "kinds": { "vidaa": { "t": "rkey.menu", "icon": "menu", "why": "VIDAA's KEY_MENU is its settings screen; the TV calls it Menu" } } }
      ]
    ],
    "media": [
      [
        { "id": "mute", "icon": "mute", "t": "rkey.mute", "key": "MUTE" },
        { "id": "playpause", "icon": "play_pause", "t": "rkey.playpause", "key": "PLAY_PAUSE", "style": "play",
          "web": { "t": "rkey.playpause_web" }, "why": "the web button is narrower: no spaces around the slash" }
      ],
      [
        { "id": "previous", "icon": "prev", "t": "rkey.previous", "key": "PREV" },
        { "id": "next", "icon": "next", "t": "rkey.next", "key": "NEXT" }
      ],
      [
        { "id": "rewind", "icon": "rewind", "t": "rkey.rewind", "key": "REWIND" },
        { "id": "forward", "icon": "ffwd", "t": "rkey.forward", "key": "FFWD" }
      ]
    ]
  },
  "simple": {
    "_": "The Simple remote (Tools → Simple remote; the share link's ?simple=1): only these keys, big, words under each, nothing else on the screen; leaving it is a 2 s hold on a small button. One row per line, drawn by both sides (web: drawSimple in js/remote.js; Phone app: simpleRemote in Simple.kt). The same entry shapes as 'rows'; 'expand': 'pad' is the side's own D-pad (arrows + OK), drawn larger; 'when': 'voice' shows Speak only where this device can hear (the page: the browser's speech or the TV's mic link; the phone always).",
    "rows": [
      [
        { "id": "simple-power", "icon": "power", "t": "remote.power", "key": "POWER", "style": "power" },
        { "id": "simple-voice", "icon": "mic", "t": "remote.speak", "do": "voice", "when": "voice" }
      ],
      [
        { "id": "simple-pad", "expand": "pad" }
      ],
      [
        { "id": "simple-back", "icon": "back", "t": "rkey.back", "key": "BACK" },
        { "id": "simple-home", "icon": "home", "t": "rkey.home", "key": "HOME" }
      ],
      [
        { "id": "simple-vol-down", "icon": "vol_down", "t": "rkey.vol_down", "key": "VOL_DOWN" },
        { "id": "simple-mute", "icon": "mute", "t": "rkey.mute", "key": "MUTE" },
        { "id": "simple-vol-up", "icon": "vol_up", "t": "rkey.vol_up", "key": "VOL_UP" }
      ],
      [
        { "id": "simple-ch-down", "icon": "down", "t": "rkey.ch_down", "key": "CH_DOWN" },
        { "id": "simple-ch-up", "icon": "up", "t": "rkey.ch_up", "key": "CH_UP" }
      ]
    ]
  },
  "roku": {
    "_": "Roku's hidden screens (the guide's #brands): each is Home, then arrows / Rev / Fwd, pressed one by one over ECP. 'gap' ms between two presses; 'homeGap' between two Home presses (the Roku takes them faster); 'keys' are this file's key names, 'NAME*3' = three presses; 'tvOnly': only a Roku TV (a stick has no such screen); 'ask': a question first, because it reboots. Run by rokuScreens (js/remote.js, PhoneRemote.kt).",
    "gap": 350,
    "homeGap": 250,
    "screens": [
      { "id": "platform", "t": "roku.s_platform", "keys": "HOME*5 FFWD DOWN REWIND DOWN FFWD" },
      { "id": "wifi", "t": "roku.s_wifi", "keys": "HOME*5 UP DOWN UP DOWN UP" },
      { "id": "system", "t": "roku.s_system", "keys": "HOME*5 FFWD*3 REWIND*2" },
      { "id": "ads", "t": "roku.s_ads", "keys": "HOME*5 UP RIGHT DOWN LEFT UP" },
      { "id": "hdmi", "t": "roku.s_hdmi", "keys": "HOME*5 DOWN LEFT UP*3", "tvOnly": true },
      { "id": "channels", "t": "roku.s_channels", "keys": "HOME*3 UP*2 LEFT RIGHT LEFT RIGHT LEFT" },
      { "id": "developer", "t": "roku.s_developer", "keys": "HOME*3 UP*2 RIGHT LEFT RIGHT LEFT RIGHT" },
      { "id": "network", "t": "roku.s_network", "keys": "HOME*5 RIGHT LEFT RIGHT LEFT RIGHT" },
      { "id": "restart", "t": "roku.s_restart", "keys": "HOME*5 UP REWIND*2 FFWD*2", "ask": "roku.restart_ask", "askOk": "roku.restart_ok" },
      { "id": "tvmenu", "t": "roku.s_tvmenu", "keys": "HOME*5 REWIND DOWN FFWD DOWN REWIND", "tvOnly": true }
    ]
  },
