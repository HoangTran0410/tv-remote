<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- defined by TV Setup, signature level: held only because this app has TV Setup's key -->
    <uses-permission android:name="dev.tvremote.setup.permission.KEYS" />
    <!-- Android 11+: the add-on must see TV Setup to bind its service -->
    <queries><package android:name="dev.tvremote.setup" /></queries>
    <application android:label="@string/app_name" android:icon="@drawable/icon" android:banner="@drawable/banner" android:allowBackup="false">
        <!-- the first key of the TV's remote after the screen off only turns it on (KeyCatch.kt); on only while it is off, set by the shell -->
        <service android:name=".KeyCatch" android:exported="false" android:label="@string/keys_wake"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/keycatch" />
        </service>
        <!-- the remote's buttons that only the stock launcher answered (Input, YouTube...), and the hold keys; TV Setup decides (KeyFixService.kt) -->
        <service android:name=".KeyFixService" android:exported="false" android:label="@string/keys_fix"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/keyfix" />
        </service>
    </application>
</manifest>
