<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />   <!-- the tap a key gives under the finger -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />   <!-- which Wi-Fi network to scan for TVs -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />   <!-- installing its own update -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />   <!-- Android 12+: its own update with no question (QuietUpdate) -->
    <!-- the TV's sound on the phone with its screen off (ListenService), and the widget / tiles' short jobs (SceneService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />   <!-- a copy to the TV goes on in the background -->
    <!-- the remote in the notification (NotificationRemote), a TV reached over the network: Android 14 wants one of its listed permissions with it -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />   <!-- MIUI cut a copy's network in the background, its notification shown -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />   <!-- Quick talk (Talk.kt): hears you only while the button is held, asked the first time with a reason -->
    <uses-permission android:name="android.permission.CAMERA" />   <!-- Video on the TV: your camera in a box on the TV, asked the first time it is used -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.TRANSMIT_IR" />   <!-- the infrared remote (IrRemote.kt): the phone's own IR LED -->
    <uses-feature android:name="android.hardware.consumerir" android:required="false" />
    <!-- the photo picker sheet: Android's own, or Google Play services' on Android 12 and older -->
    <queries>
        <package android:name="com.universal.remote.multi" />   <!-- Hisense's VIDAA app: its certificate (Vidaa.kt) -->
        <package android:name="com.vidaa.smarttv" />
        <package android:name="com.hisense.tv.remotenow" />
        <intent><action android:name="android.speech.RecognitionService" /></intent>   <!-- Quick talk: is there a speech service (Talk.kt) -->
        <intent><action android:name="android.provider.action.PICK_IMAGES" /></intent>
        <intent><action android:name="androidx.activity.result.contract.action.PICK_IMAGES" /></intent>
    </queries>
    <application android:name=".PhoneApp" android:label="TV Remote" android:icon="@drawable/icon"
        android:theme="@style/AppDark" android:allowBackup="false" android:usesCleartextTraffic="true" android:supportsRtl="true">   <!-- the in-app page is served from 127.0.0.1 -->
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:supportsPictureInPicture="true" android:resizeableActivity="true" android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:label="TV Remote">                  <!-- Share → TV Remote: a link opens on the TV, a photo / video / song plays there -->
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>
        <!-- the widget, the Quick Settings tiles and the app icon's shortcuts land here; it shows nothing (SceneActivity.kt) -->
        <activity android:name=".SceneActivity" android:exported="false" android:theme="@android:style/Theme.NoDisplay" android:excludeFromRecents="true"
            android:taskAffinity="" android:noHistory="true" />
        <service android:name=".SceneService" android:exported="false" android:foregroundServiceType="shortService" />
        <service android:name=".ListenService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <service android:name=".WorkService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name=".NotificationRemote" android:exported="false" android:foregroundServiceType="connectedDevice" />
        <receiver android:name=".QuietUpdate$Done" android:exported="false" />
        <receiver android:name=".RemoteWidget" android:exported="true" android:label="@string/widget_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
        </receiver>
        <service android:name=".PowerTile" android:exported="true" android:label="@string/tile_power" android:icon="@drawable/ic_power"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".SceneTile" android:exported="true" android:label="@string/tile_scene" android:icon="@drawable/ic_scene"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
    </application>
</manifest>
