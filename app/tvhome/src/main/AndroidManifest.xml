<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />   <!-- its own update, asked first (SelfUpdate) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />   <!-- "Uninstall" in an app's menu: the system asks first -->
    <uses-permission android:name="android.permission.INTERNET" />               <!-- the weather widget (Weather: Open-Meteo, the place from the internet address) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />   <!-- Wi-Fi, cable or offline on the network button -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />      <!-- the Wi-Fi signal on the system widget (Widgets) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />   <!-- the Wi-Fi's name on the network button: granted over ADB only (HomeConfig.GRANT_WIFI) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" /> <!-- Android 12+ wants it beside FINE -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />     <!-- Android TV's pairing screen (Control Center's Bluetooth) needs it: ADB grants it (HomeConfig.GRANT_WIFI), else asked on the first press -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />       <!-- other apps' Play Next and channels (apps/Watch.kt): granted over ADB (HomeConfig.GRANT_WIFI) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />   <!-- only ever granted over ADB (Dream.kt): the screensaver switch -->
    <queries>                                                         <!-- the apps it lists, and TV Setup for the usage widget -->
        <package android:name="dev.tvremote.setup" />
        <package android:name="dev.tvremote.channels" />           <!-- its "Keep watching" live widget: its key is checked (LiveWidgets) -->
        <package android:name="dev.tvremote.games" />              <!-- its pins' sharp pictures (tvui PinArt), with Channels' -->
        <package android:name="com.esaba.downloader" />           <!-- the power button opens it to get TV Setup -->
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.media.tv.TvInputService" /></intent>   <!-- Android 11+ hides other apps' input services without it: the inputs list came back empty -->
        <package android:name="com.tcl.settings" /><package android:name="com.tcl.sourcemananger" />   <!-- TCL's source panel (Inputs.panel) -->
        <intent><action android:name="com.xgimi.action.hdmiPlayer" /></intent>                       <!-- XGIMI's HDMI player (Inputs.xgimi) -->
        <provider android:authorities="com.skyworth.tv.provider" />                  <!-- Coocaa OS lists its sources there (Inputs.coocaa) -->
        <provider android:authorities="com.skyworth.tv.sdk.provider" />
        <package android:name="com.tcl.tv" /><package android:name="com.sony.dtv.tvx" /><package android:name="com.mediatek.wwtv.tvcenter" /><package android:name="com.mitv.livetv" />
        <package android:name="com.realtek.tv" /><package android:name="com.cltv.hybrid" /><package android:name="com.android.tv" />   <!-- Inputs.LIVE_APPS: a TV with inputs of its own -->
        <package android:name="com.xiaomi.mitv.settings" /><package android:name="com.amazon.tv.launcher" /><package android:name="com.android.tv.settings" />   <!-- SystemSettings: the vendors' Settings (com.tcl.settings is listed above) -->
        <intent><action android:name="android.settings.DISPLAY_SETTINGS" /></intent>   <!-- the Picture and Sound rows show only where the TV has those screens -->
        <intent><action android:name="android.settings.SOUND_SETTINGS" /></intent>
        <intent><action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" /><data android:scheme="package" /></intent>   <!-- App info shows only where the TV has it -->

        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>   <!-- the news reader shows "Open in browser" only where one exists -->
        <intent><action android:name="android.intent.action.VIEW" /><category android:name="android.intent.category.BROWSABLE" /><data android:scheme="https" android:host="www.youtube.com" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><category android:name="android.intent.category.BROWSABLE" /><category android:name="android.intent.category.DEFAULT" /><data android:scheme="https" android:host="youtu.be" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" android:host="www.youtube.com" android:path="/watch" /></intent>   <!-- who opens a pinned YouTube link (LinkApps): any app taking it, a mod too -->
        <intent><action android:name="android.intent.action.VIEW" /><category android:name="android.intent.category.BROWSABLE" /><data android:scheme="https" android:host="example.com" android:pathPattern=".*" /></intent>   <!-- the probe that tells a browser from an app of that link -->
        <intent><action android:name="com.android.tv.action.VIEW_INPUTS" /></intent>   <!-- InputOpen.sync: does anything else answer it -->
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="content" android:mimeType="vnd.android.cursor.item/channel" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="content" android:mimeType="vnd.android.cursor.dir/channel" /></intent>
    </queries>
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:name=".HomeApp" android:label="@string/app_name" android:icon="@drawable/icon" android:banner="@drawable/banner" android:allowBackup="false"
        android:theme="@style/Home" android:supportsRtl="false"
        android:usesCleartextTraffic="true">   <!-- the web wall: a page on the LAN (an Immich Kiosk) is plain http -->
        <profileable android:shell="true" />   <!-- simpleperf on the release build, the one people run (a debug build runs interpreted: 2x the CPU) -->
        <activity android:name=".HomeActivity" android:exported="true" android:launchMode="singleTask" android:stateNotNeeded="true"
            android:excludeFromRecents="true" android:clearTaskOnLaunch="true" android:resumeWhilePausing="true" android:directBootAware="true"
            android:screenOrientation="landscape" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The remote's Input key while another app is in front: the system sends VIEW_INPUTS to whoever answers it. Off from the start and
             turned on by InputOpen.sync only when nothing else answers (the stock launcher turned off by Optimize TV / the swap; TV Setup
             declares no filter: its InputsActivity is started by name, by KeysBridge (TV Setup, for the key filter of TV Setup Keys), after this intent finds nobody). Where the TV has
             an answer of its own two would make Android ask which on every press, and a priority cannot outbid it (non-system apps get 0). -->
        <activity-alias android:name=".InputsEntry" android:targetActivity=".HomeActivity" android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="com.android.tv.action.VIEW_INPUTS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <!-- the screensaver: the clock, the date and the wallpaper; chosen in the TV's settings, or by the "screensaver" switch (Dream.kt) -->
        <activity android:name=".ScreensaverActivity" android:exported="false" android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />
        <service android:name=".HomeDream" android:exported="true" android:label="@string/app_name" android:icon="@drawable/icon"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter><action android:name="android.service.dreams.DreamService" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream" />
        </service>
        <activity android:name=".DreamSettings" android:exported="true" android:theme="@style/Ghost" android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|locale|layoutDirection" />
        <!-- the News widget's reader and the weather widget's map: opened from the home screen only -->
        <activity android:name=".widgets.NewsActivity" android:exported="false" android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|locale|layoutDirection" />
        <activity android:name=".widgets.MarketActivity" android:exported="false" android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|locale|layoutDirection" />
        <activity android:name=".widgets.WeatherMapActivity" android:exported="false" android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|locale|layoutDirection" />
        <!-- another app pins a shortcut here (Android 8+): Pins.kt; the request is the system's own object, a forged intent carries none -->
        <activity android:name=".PinActivity" android:exported="true" android:theme="@style/Ghost" android:excludeFromRecents="true"
            android:noHistory="true" android:taskAffinity="">
            <intent-filter><action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" /></intent-filter>
        </activity>
        <!-- TV Setup hands a key's or the power-on app's shortcut / live widget here (only the home screen may start one): Targets.kt, which opens only what the settings name -->
        <!-- a pinned link (YouTube...): the shortcut's own target, not exported; it finds the app that takes the link now (apps/LinkApps.kt) -->
        <activity android:name=".LinkActivity" android:exported="false" android:theme="@style/Ghost" android:excludeFromRecents="true"
            android:noHistory="true" android:taskAffinity="" />
        <!-- the Control Center over whatever app is in front (a remote key set to it in TV Setup's key filter); Back closes it, the app beneath keeps running -->
        <activity android:name=".ControlCenterActivity" android:exported="true" android:theme="@style/Ghost" android:excludeFromRecents="true"
            android:taskAffinity="" android:launchMode="singleTask" />
        <activity android:name=".OpenActivity" android:exported="true" android:theme="@style/Ghost" android:excludeFromRecents="true"
            android:noHistory="true" android:taskAffinity="" />
        <!-- its settings, from a phone or computer that has ADB here (core/ontv/Home.kt); DUMP is held by the shell only, so no app can -->
        <receiver android:name=".HomeReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <receiver android:name="dev.tvremote.update.SelfUpdate$Installed" android:exported="false" />
    </application>
</manifest>
