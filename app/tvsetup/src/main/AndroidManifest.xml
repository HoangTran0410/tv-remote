<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <permission android:name="dev.tvremote.setup.permission.KEYS" android:protectionLevel="signature" />   <!-- only an app with this app's key (TV Setup Keys) may bind KeysBridge -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />   <!-- its own update without ADB, asked first (MainActivity.selfUpdate) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />   <!-- sees Tailscale's VPN go down (TailscaleWatch), and the Wi-Fi (Stats) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />      <!-- the Wi-Fi signal, for the History view (Stats) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />   <!-- the chip kept up while the TV is off, when asked (KeepAwake) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />   <!-- the remote's mic button, when switched on (MicVoice); allowed through ADB or asked on the TV -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />   <!-- "Remove TV Setup" without ADB: Android's own uninstall prompt -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />   <!-- drawing over the screen (DrawLayer); allowed through ADB -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />   <!-- ADB debugging back on when switched off (KeepAdb); granted through ADB -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />   <!-- is the app a remote button was sent to still there? (KeyFix) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />   <!-- which app is on screen, for the History view; granted through ADB -->
    <queries>                                                          <!-- to list the apps on the TV's home screen -->
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>   <!-- the TV's voice engines, to read a message aloud (NotifySpeak) -->
        <package android:name="com.tailscale.ipn" />                 <!-- its updates, to switch it back on (TailscaleWatch) -->
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.HOME" /></intent>   <!-- home screens left out of TV Home's usage widget (HomeInfo) -->
        <package android:name="dev.tvremote.home" />                  <!-- TV Home's key, checked before it is told the usage -->
        <package android:name="dev.tvremote.channels" />              <!-- Channels and Games: their key, checked before they are told the stats switch (HomeInfo "census") -->
        <package android:name="dev.tvremote.games" />
        <package android:name="dev.tvremote.apps" />                  <!-- TV Apps: its key, before HomeInfo "tvapps" installs for it -->
    </queries>
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:name=".SetupApp" android:label="TV Setup" android:icon="@drawable/icon" android:banner="@drawable/banner"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar" android:allowBackup="false" android:networkSecurityConfig="@xml/net">
        <activity android:name=".MainActivity" android:exported="true" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- the web UI on the TV itself (RemoteService's page, let in by a pass only this process has) -->
        <activity android:name=".ManageActivity" android:exported="false" android:process=":web" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize" />
        <!-- PairActivity and WarnActivity: started by this app and by the shell (am start over ADB: DUMP is held by the shell only), never by another app -->
        <activity android:name=".PairActivity" android:exported="true" android:permission="android.permission.DUMP" android:excludeFromRecents="true" android:launchMode="singleTop" />
        <!-- the sleep timer, bedtime, app limits and "turn off when idle" warn over whatever is on screen; started through the TV's ADB (Guard.kt).
             Its own task: in TV Setup's task it brought TV Setup (and its PIN screen) up over the warning instead of the app watched (FPT, 2026-11-07) -->
        <activity android:name=".WarnActivity" android:exported="true" android:permission="android.permission.DUMP" android:excludeFromRecents="true" android:launchMode="singleTop"
            android:taskAffinity="" android:theme="@android:style/Theme.Translucent.NoTitleBar" android:noHistory="true" />
        <!-- a locked app's PIN, over it (Guard.kt): its own task, so the app is back under it once the PIN is given -->
        <activity android:name=".PinActivity" android:exported="true" android:permission="android.permission.DUMP" android:excludeFromRecents="true" android:launchMode="singleTop"
            android:taskAffinity="" android:theme="@android:style/Theme.NoTitleBar.Fullscreen" android:noHistory="true" />
        <!-- the launcher gallery: "Keep this launcher?" and the notice that the TV went back to its own; started through the TV's ADB (LauncherGuard.kt, LauncherInstall) -->
        <activity android:name=".LauncherConfirmActivity" android:exported="true" android:permission="android.permission.DUMP" android:excludeFromRecents="true" android:launchMode="singleTop"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:noHistory="true" />
        <!-- started by the shell too (DUMP: no app can), when a receiver may not start it from the background: RulesClient, SetupUpdate -->
        <service android:name=".RemoteService" android:exported="true" android:permission="android.permission.DUMP" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="web remote control served on the local network" />
        </service>
        <!-- hands a TV Setup pass to a device that already has ADB; DUMP is held by the shell only, so no app can ask -->
        <receiver android:name="dev.tvremote.update.SelfUpdate$Installed" android:exported="false" />
        <receiver android:name=".TrustReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- timers and limits for a device that has ADB here (RulesClient.kt); held by the shell only, like the one above -->
        <receiver android:name=".RulesReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- app use for TV Home's widgets: open to every app, answered only for TV Home with this project's key (HomeInfo checks) -->
        <provider android:name=".HomeInfo" android:authorities="dev.tvremote.setup.home" android:exported="true" />
        <!-- drawing over the screen for a device that has ADB here (DrawLayer.kt, Draw.kt) -->
        <receiver android:name=".DrawReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- a video in a movable box over the screen: a file or a phone's / computer's camera (VideoLayer.kt, Video.kt) -->
        <receiver android:name=".VideoReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- the tint over the whole screen, for a device that has ADB here (DimLayer.kt, Dim.kt) -->
        <receiver android:name=".DimReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- a message in a corner of the screen for a device that has ADB here (NotifyLayer.kt, Notify.kt) -->
        <receiver android:name=".NotifyReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- the accessibility services (dead remote buttons, the key that wakes the screen) are NOT here: they are in the add-on TV Setup Keys
             (app/tvkeys, packed in assets/tvkeys.apk, put on the TV over ADB by KeysAddon.kt), because Play Protect blocks an app that declares one
             when it is installed from a browser or Downloader. The add-on has this app's key, and asks this service about each key (KeysBridge.kt) -->
        <service android:name=".KeysBridge" android:exported="true" android:permission="dev.tvremote.setup.permission.KEYS" />
        <!-- the voice screen the remote's mic button opens, when switched on (MicVoice.kt); started by the key filter's service of this app, and by the shell (DUMP: no app can) for tests -->
        <activity android:name=".MicActivity" android:exported="true" android:permission="android.permission.DUMP" android:excludeFromRecents="true" android:launchMode="singleTask" android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:noHistory="true" />
        <!-- the TV's assistant while the rule "mic" is on (MicVoice.takeAssist): the window manager keeps the mic button from the key filter -->
        <activity-alias android:name=".MicAssist" android:targetActivity=".MicActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.ASSIST" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
        </activity-alias>
        <!-- the same for a TV with no ADB (cannot set the assistant): the mic key starts WEB_SEARCH there, and the person picks TV Setup once. Off in the manifest, on only while the rule "mic" is on (MicVoice.syncSearch), so no other TV sees TV Setup in a chooser -->
        <activity-alias android:name=".MicSearch" android:targetActivity=".MicActivity" android:exported="true" android:enabled="false">
            <intent-filter><action android:name="android.speech.action.WEB_SEARCH" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
        </activity-alias>
        <!-- a scene tile on TV Home (ScenePin.kt): only TV Home's pinned shortcut starts it, so it is not exported -->
        <activity android:name=".SceneRunActivity" android:exported="false" android:excludeFromRecents="true" android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" android:noHistory="true" />
        <!-- the key tester (KeyTestActivity): started by this app, by TV Home (a PendingIntent of HomeControl) and by the shell (am start) -->
        <activity android:name=".KeyTestActivity" android:exported="true" android:permission="android.permission.DUMP" android:excludeFromRecents="true" android:launchMode="singleTask" android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize" />
        <!-- TV Setup Voice offered and switched (VoiceActivity): from TV Home's Control Center (a PendingIntent of HomeControl) and the More TV apps row -->
        <activity android:name=".VoiceActivity" android:exported="false" android:excludeFromRecents="true" android:launchMode="singleTask" android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />
        <!-- the Input button's picker where the TV has none (KeysBridge) -->
        <activity android:name=".InputsActivity" android:exported="false" android:excludeFromRecents="true" android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar" />
        <!-- the welcome screen (Welcome.kt): set up by a device that has ADB here; held by the shell only, like the ones above -->
        <receiver android:name=".WelcomeReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- full screen over everything when the TV is turned on; started by this app, and by the shell (am start) -->
        <activity android:name=".WelcomeActivity" android:exported="true" android:permission="android.permission.DUMP" android:excludeFromRecents="true"
            android:launchMode="singleTask" android:taskAffinity="" android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize" />
        <!-- plays a file sent from a client (looping, aspect kept); started by explicit component from the shell only -->
        <activity android:name=".PlayActivity" android:exported="true" android:permission="android.permission.DUMP" android:excludeFromRecents="true"
            android:launchMode="singleTask" android:taskAffinity="" android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize" />
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />   <!-- after this app updates itself -->
            </intent-filter>
        </receiver>
    </application>
</manifest>
