# secrets: these pair this machine with the TV, never commit
cert.pem
key.pem
*.pem
# signing keys of the Android apps: whoever has them can publish updates under the apps' names
*.jks
# this machine's own data and downloads
tvs.json
tvs.json.tmp
venv/
tools/
.cache/
__pycache__/
*.log
.DS_Store
# build output
app/*/build/
app/gradle/.gradle/
app/gradle/.kotlin/
app/gradle/build/
app/gradle/local.properties
.idea/
# APKs are attached to releases, never committed
*.apk                                                     # anywhere: a test once left app/shared/tv-home.apk in git
*.tvrkeys

# dev/test/layout.js: Playwright, installed with npm install --prefix dev playwright
dev/node_modules/
dev/package.json
dev/package-lock.json

# per-machine speed baselines (dev/perf): never committed
dev/perf/.local/
dev/test/.local/
# wrangler dev / d1 local state and cache (dev/census)
.wrangler/
.dev.vars
.codegraph/
node_modules/
